<?xml version="1.0" encoding="utf-8"?>
<!-- DiamaneOS: a button among the barcode format toggles, so it looks like the camera's other round
     buttons (a white ring on the controls' scrim) and never like a chosen format. -->
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

  <item>

    <shape
        android:shape="oval">

      <solid android:color="@color/camera_control_scrim"/>

      <stroke
          android:width="2dp"
          android:color="@android:color/white"/>

      <padding
          android:bottom="2dp"
          android:left="2dp"
          android:right="2dp"
          android:top="2dp"/>

    </shape>

  </item>

  <item
      android:drawable="@drawable/tally_more_dots"/>

</layer-list>
