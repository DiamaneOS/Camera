<?xml version="1.0" encoding="utf-8"?>
<!-- DiamaneOS: a drop-down field, a raised surface with a chevron at its end (Tally keys: radius 8).
     The surface is 40 dp tall whatever the row height, so all fields match. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item
        android:height="40dp"
        android:gravity="center_vertical|fill_horizontal">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:width="24dp"
        android:height="24dp"
        android:end="8dp"
        android:gravity="end|center_vertical"
        android:drawable="@drawable/tally_chevron_down" />
</ripple>
