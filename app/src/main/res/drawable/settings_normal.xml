<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:height="18dp"
                android:width="35dp"/>
            <padding
                android:left="8dp"
                android:right="8dp"/>
            <solid android:color="@color/camera_settings_scrim"/>
            <corners android:radius="@dimen/camera_control_radius"/>
        </shape>
    </item>
    <item android:drawable="@drawable/settings_expand"
        android:width="24dp"
        android:height="24dp"
        android:gravity="center"/>
</layer-list>
