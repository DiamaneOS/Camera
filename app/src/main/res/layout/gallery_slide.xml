<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_height="match_parent"
    android:layout_width="match_parent">

    <app.grapheneos.camera.ui.ZoomableImageView
        android:id="@+id/slide_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/preview"/>

    <ImageView
        android:id="@+id/play_button"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:src="@drawable/play_button_circle"
        android:importantForAccessibility="no"/>

    <include
        layout="@layout/gallery_placeholder"
        android:id="@+id/placeholder_text"
    />
    <LinearLayout
        android:id="@+id/processing_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="#E6000000"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/processing_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/photo_processing"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:accessibilityLiveRegion="polite" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry_processing"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/retry_photo_processing"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_to_default"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/save_to_default_location"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
